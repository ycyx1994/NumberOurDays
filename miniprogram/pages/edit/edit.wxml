<view class="page">
  <view class="card form">
    <view class="label">标题</view>
    <input class="input" maxlength="30" placeholder="最多 30 字" value="{{title}}" bindinput="onTitle" />

    <view class="label">日期</view>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="input picker">{{date}}</view>
    </picker>

    <view class="label">重复</view>
    <switch checked="{{repeatOn}}" color="#D4553A" bindchange="onRepeat" />
    <block wx:if="{{repeatOn}}">
      <view class="label">每多少次</view>
      <input class="input" type="number" value="{{interval}}" bindinput="onInterval" />
      <view class="label">单位</view>
      <picker range="{{units}}" value="{{unitIndex}}" bindchange="onUnit">
        <view class="input picker">{{units[unitIndex]}}</view>
      </picker>
    </block>

    <view class="label">备注</view>
    <textarea class="textarea" maxlength="100" placeholder="可选" value="{{note}}" bindinput="onNote" />

    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="btn-primary" bindtap="onSave">保存</view>
  </view>
</view>
