.page { padding: 24rpx 32rpx 48rpx; }
.hero { text-align: center; margin-bottom: 24rpx; }
.tag { color: #8a8175; font-size: 22rpx; }
.title { font-size: 32rpx; font-weight: 600; margin: 8rpx 0; }
.days { font-size: 96rpx; font-weight: 700; color: #d4553a; }
.unit { font-size: 28rpx; color: #4a453e; margin-left: 8rpx; }
.date { color: #8a8175; font-size: 24rpx; }
.units { display: flex; gap: 16rpx; justify-content: center; margin: 16rpx 0 24rpx; }
.chip {
  padding: 12rpx 32rpx; border-radius: 28rpx; background: #f3eee6; color: #4a453e; font-size: 26rpx;
}
.chip.on { background: #d4553a; color: #fff; }
.meta .row {
  display: flex; justify-content: space-between;
  padding: 22rpx 8rpx; border-bottom: 1rpx solid #e8e1d6; color: #8a8175; font-size: 26rpx;
}
.meta .v { color: #1c1916; text-align: right; max-width: 60%; }
.actions { margin-top: 48rpx; display: flex; flex-direction: column; gap: 20rpx; }
.empty { padding: 80rpx; text-align: center; color: #8a8175; }
