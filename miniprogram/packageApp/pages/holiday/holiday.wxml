<view class="page">
  <view class="group" wx:for="{{groups}}" wx:key="year" wx:for-item="group">
    <view class="group-head" data-year="{{group.year}}" bindtap="toggle">
      <text class="group-title">{{group.year}} 年</text>
      <text class="chevron {{group.expanded ? 'open' : ''}}">▸</text>
    </view>
    <view wx:if="{{group.expanded}}">
      <view class="card row" wx:for="{{group.rows}}" wx:key="start">
        <view class="left">
          <view class="name">{{item.name}}</view>
          <view class="range">{{item.start}} ~ {{item.end}} · 放假 {{item.vacationDays}} 天</view>
        </view>
        <view class="status {{item.past ? 'muted' : ''}}">
          {{item.ongoing ? '假期中' : (item.past ? '已过 ' + item.daysPastEnd + ' 天' : '还有 ' + item.daysUntilStart + ' 天')}}
        </view>
      </view>
    </view>
  </view>
</view>
