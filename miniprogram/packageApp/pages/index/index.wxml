<view class="page">
  <view class="hero-wrap" wx:if="{{slides.length}}">
    <swiper
      class="hero-swiper"
      circular="{{slides.length > 1}}"
      current="{{current}}"
      bindchange="onSwiperChange"
      indicator-dots="{{slides.length > 1}}"
      indicator-active-color="#D4553A"
      indicator-color="#C9C0B2"
    >
      <swiper-item wx:for="{{slides}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
        <view class="hero card">
          <view class="hero-tag">下一个 · {{item.label}}</view>
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-days">{{heroValue}}<text class="hero-unit">{{heroSuffix}}</text></view>
          <view class="hero-date">{{item.date}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="section-title">全部纪念日</view>
  <view class="list">
    <view class="row" wx:for="{{displays}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <view class="row-main">
        <view class="row-title">{{item.starred ? '★ ' : ''}}{{item.title}}</view>
        <view class="row-sub">{{item.date}} · {{item.kind === 'ELAPSED' ? '已过' : (item.kind === 'TODAY' ? '今天' : (item.repeatLabel || '倒数'))}}</view>
      </view>
      <view class="row-label">{{item.label}}</view>
    </view>
    <view wx:if="{{!displays.length}}" class="empty">还没有纪念日，点下方按钮添加</view>
  </view>

  <view class="footer-actions">
    <view class="foot-btn" bindtap="onSettings">
      <view class="foot-icon">⚙</view>
      <view class="foot-text">设置</view>
    </view>
    <view class="foot-btn foot-btn-accent" bindtap="onAdd">
      <view class="foot-icon">＋</view>
      <view class="foot-text">添加</view>
    </view>
  </view>
</view>
